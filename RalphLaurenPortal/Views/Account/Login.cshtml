@using RalphLaurenPortal.Models
@model LoginViewModel
@{ 
    var l = Model.LanguageID;
    var c = Model.CountryID;
    var d = Model.ContentDate;
}
<div class="container d-flex align-items-center justify-content-center h-100">
    @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal login-form", role = "form" }))
    {
        @*<div class="py-5">
            <h3 class="pb-4">
                Sorry
            </h3>
            <p>
                05/22/2022
            </p>
            <p>
                This site is temporarily down for upgrade work. Access has been restricted.
            </p>
            <p>
                Please contact <a href="mailto:itsupport@designersguild.com">itsupport@designersguild.com</a> if you would like to get in touch.
            </p>
            <p>
                Thank you for your patience.
            </p>
        </div>*@
        <h3>
            @HtmlHelperExtra.ResourceTitleCase("urlLoginKeyword", l, c, d)
        </h3>
        @Html.AntiForgeryToken()
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="mb-3">
            @Html.LabelFor(m => m.Username, HtmlHelperExtra.Resource("Username", l, c, d).ToString(), new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Username, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.Password, HtmlHelperExtra.Resource("Password", l, c, d).ToString(), new { @class = "form-label" })
            @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
        </div>
        <div class="d-flex justify-content-between align-items-center my-3">
            <div class="form-check">
                @Html.CheckBoxFor(m => m.RememberMe, new { id = "remember-me", @class="form-check-input" })
                @Html.LabelFor(m => m.RememberMe, new { @for = "remember-me", @class="form-check-label" })
            </div>
            <button type="submit" class="btn btn-secondary">
                @HtmlHelperExtra.Resource("SignIn", l, c, d)
            </button>
        </div>
    }
</div>