@model HomeViewModel
@{ 
    var l = Model.LanguageID;
    var c = Model.CountryID;
    var d = Model.ContentDate;
    var cu = Model.DotNetCulture;
}
<script type="text/javascript">
    getCollections = () => {
        return @Html.Raw(JsonConvert.SerializeObject(Model.CollectionDropDown.Collections))
    }
</script>
<div id="product-search-content" style="display: none" data-bind="visible: true">
    <div class="page-blocker" style="display: none;" data-bind="fadeVisible: busy">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <h4 data-bind="text: busyMessage"></h4>
    </div>
    <div class="input-group">
        <select id="product-type-select"
                name="ProductTypeID"
                class="form-select"
                data-bind="value: productTypeId">
            <option value="" selected>
                @HtmlHelperExtra.Resource("AllProductTypes", l, c, d)
            </option>
            @foreach(var pt in Model.ProductTypeDropDown.ProductTypes)
            {
                <option value="@(pt.ProductTypeID)">
                    @(pt.Name)
                </option>
            }
        </select>
        <select id="collection-select"
                name="CollectionID"
                class="form-select"
                data-bind="value: collection,
                options: availableCollections,
                optionsText: 'Name',
                optionsValue: $data,
                optionsCaption: resources.AllCollections,
                attr: { title: collectionName }">
            <option value="" selected>
                @HtmlHelperExtra.Resource("AllCollections", l, c, d)
            </option>
            @foreach(var cl in Model.CollectionDropDown.Collections)
            {
                <option value="@(cl.CollectionID)">
                    @(cl.Name)
                </option>
            }
        </select>
        @if (Convert.ToBoolean(WebConfigurationManager.AppSettings["productionVersion"]) == false)
        {
            <input type="hidden" name="dateOverride" value="@(Request.QueryString["dateOverride"])" />
            <input type="hidden" name="countryOverride" value="@(Request.QueryString["countryOverride"])" />
        }
        <input id="product-search-control"
                name="SearchTerm"
                type="text"
                class="form-control"
                placeholder="@HtmlHelperExtra.Resource("RalphLaurenProductSearch", l, c, d)"
                aria-label="@HtmlHelperExtra.Resource("RalphLaurenProductSearch", l, c, d)"
                data-bind="forceNullOnEmpty: searchTerm, 
                            enterKey: search,
                            textInput: searchTerm" />
        <button class="btn btn-outline-secondary" data-bind="click: clearSearchTerm">
            <i class="bi bi-x-lg"></i>
        </button>
        <button class="btn btn-light-gray"
                type="button" 
                aria-label="@HtmlHelperExtra.Resource("SubmitProperCase", l, c, d)"
                data-bind="click: () => { collection.valueHasMutated() }">
            <span class="d-none d-sm-inline me-1">
                @HtmlHelperExtra.Resource("EnterSearch", l, c, d)
            </span>
            <i class="fa fa-caret-right"></i>
        </button>
    </div>
    <!-- ko if: haveSearchedOnce -->
    <div class="d-flex justify-content-between align-items-center mt-3">
        <h6 class="m-0">
            <span data-bind="text: searchResultCountDisplay"></span>
        </h6>
        <!-- ko if: anySearchResults -->
        <button class="btn btn-link" data-bind="click: (data) => { fetchProductFeed() }">
            @HtmlHelperExtra.Resource("DownloadToExcel", l, c, d)
        </button>
        <!-- /ko -->
    </div>
    <!-- /ko -->
    <div id="search-results" class="search-result-grid grid pt-3">
        <!-- ko foreach: searchResults  -->
        <div class="result g-col-6 g-col-lg-4 g-col-xl-3">
            <div class="pod-card" href="#" data-bind="attr: { href: `https://www.designersguild.com${url}` }" target="_blank">
                <div class="card">
                    <img width="488" height="488" class="ripple" data-bind="attr: { src: `/image/488/${imageId}` }, click: (data) => { $parent.showProductModal(data, '#nav-tech')}" loading="lazy" />
                    <div class="card-body">
                        <!-- ko if: $data.hasOwnProperty('new') && $data.new  --> 
                        <h6 class="card-new"></h6>
                        <!-- /ko -->
                        <h6 class="card-title text-uppercase fw-bold" data-bind="text: name"></h6>
                        <div class="d-flex justify-content-between align-items-start my-2">
                            <span class="product-code" data-bind="text: code"></span>
                            <button class="btn btn-light-gray btn-sm" data-bind="click: (data) => { $parent.showProductModal(data, '#nav-tech') }">
                                @HtmlHelperExtra.Resource("TechnicalInfo", l, c, d)
                            </button>
                        </div>
                        <!-- ko if: rLRRP -->
                        <div class="d-flex justify-content-between my-1 my-sm-2">
                            <span>
                                @HtmlHelperExtra.Resource("RRP", l, c, d):
                            </span>
                            <span data-bind="text: rLRRP"></span>
                        </div>
                        <!-- /ko -->
                        <!-- ko if: rLTradePrice -->
                        <div class="d-flex justify-content-between my-1 my-sm-2">
                            <span>
                                @HtmlHelperExtra.Resource("TradePrice", l, c, d):
                            </span>
                            <span data-bind="text: rLTradePrice"></span>
                        </div>
                        <!-- /ko -->
                        <div class="stock-message d-flex justify-content-between my-1 my-sm-2 pt-1">
                            <span>
                                @HtmlHelperExtra.Resource("Stock", l, c, d):
                            </span>
                            <span data-bind="with: stockMessage.basketQuantityThresholds[0]">
                                <span data-bind="with: stockMessages[0]">
                                    <a href="javascript:;" data-bind="text: stockMessage, click: () => { $parentContext.$parentContext.$parent.showProductModal($parentContext.$parentContext.$data, '#nav-stock') }"></a>
                                </span>
                            </span>
                        </div>
                        @*<div data-bind="with: sample">
                            <div data-bind="with: stockMessage.basketQuantityThresholds[0]">-->
                                <!-- ko if: typeof stockMessages !== 'undefined' -->
                                <!--<div class="stock-message d-flex justify-content-between my-1 my-sm-2 pt-1">
                                    <span>
                                        @HtmlHelperExtra.Resource("tradeQuickSmallSample", l, c, d):
                                    </span>
                                    <span data-bind="with: stockMessages[0]">
                                        <span data-bind="text: stockMessage"></span>
                                    </span>
                                </div>-->
                                <!-- /ko -->
                            <!--</div>
                        </div>
                        <div data-bind="with: largeSample">
                            <div data-bind="with: stockMessage.basketQuantityThresholds[0]">-->
                                <!-- ko if: typeof stockMessages !== 'undefined' -->
                                <!--<div class="stock-message d-flex justify-content-between my-1 my-sm-2 pt-1">
                                    <span>
                                        @HtmlHelperExtra.Resource("tradeQuickLargeSample", l, c, d):
                                    </span>
                                    <span data-bind="with: stockMessages[0]">
                                        <span data-bind="text: stockMessage"></span>
                                    </span>
                                </div>-->
                                <!-- /ko -->
                            <!--</div>
                        </div>*@
                        <!-- ko if: AKA -->
                        <span class="d-block mt-3" data-bind="text: AKA"></span>
                        <!-- /ko -->
                    </div>
                </div>
            </div>
        </div>
        <!-- /ko -->
    </div>
</div>