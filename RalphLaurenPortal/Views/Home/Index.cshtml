                                                @HtmlHelperExtra.Resource("ViewBrochure", l, c, d)
                                            </a>
                                            <!-- /ko -->
                                            <!-- /ko -->
                                        </dd>
                                        <!-- /ko -->
                                        <!-- /ko -->
                                        <!-- ko if: typeof composition !== 'undefined' -->
